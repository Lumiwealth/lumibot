2026-09-22 23:41:27,751 | INFO | [leveraged-etf] [agents][tool_call 7] duckdb_query: sql=WITH combined AS ( \n SELECT 'SQQQ' AS symbol, 1 AS is_inverse, \n (SELECT close FROM sqqq_hist ORDER BY Date DESC LIMIT 1) AS last_price, \n (SELECT close FROM sqqq_hist ORDER BY Date DESC LIMIT 1 OFFSET 1) AS prev_close, \n (SELECT close FROM sqqq_hist ORDER BY Date DESC LIMIT 1 OFFSET 5) as close_5d, \n (SELECT close FROM sqqq_hist ORDER BY Date DESC LIMIT 1 OFFSET 20) as close_20d \n UNION ALL \n SELECT 'SPXU' AS symbol, 1 AS is_inverse, \n (SELECT close FROM spxu_hist ORDER BY Date DESC LIMIT 1) AS last_price, \n (SELECT close FROM spxu_hist ORDER BY Date DESC LIMIT 1 OFFSET 1) AS prev_close, \n (SELECT close FROM spxu_hist ORDER BY Date DESC LIMIT 1 OFFSET 5) as close_5d, \n (SELECT close FROM spxu_hist ORDER BY Date DESC LIMIT 1 OFFSET 20) as close_20d \n UNION ALL \n SELECT 'UPRO' AS symbol, 0 AS is_inverse, \n (SELECT close FROM upro_hist ORDER BY Date DESC LIMIT 1) AS last_price, \n (SELECT close FROM upro_hist ORDER BY Date DESC LIMIT 1 OFFSET 1) AS prev_close, \n (SELECT close FROM upro_hist ORDER BY Date DESC LIMIT 1 OFFSET 5) as close_5d, \n (SELECT close FROM upro_hist ORDER BY Date DESC LIMIT 1 OFFSET 20) as close_20d \n UNION ALL \n SELECT 'TQQQ' AS symbol, 0 AS is_inverse, \n (SELECT close FROM tqqq_hist ORDER BY Date DESC LIMIT 1) AS last_price, \n (SELECT close FROM tqqq_hist ORDER BY Date DESC LIMIT 1 OFFSET 1) AS prev_close, \n (SELECT close FROM tqqq_hist ORDER BY Date DESC LIMIT 1 OFFSET 5) as close_5d, \n (SELECT close FROM tqqq_hist ORDER BY Date DESC LIMIT 1 OFFSET 20) as close_20d \n ) \n SELECT symbol, is_inverse, last_price, \n (last_price - prev_close) / prev_close * 100 AS ret_1d, \n (last_price - close_5d) / close_5d * 100 AS ret_5d, \n (last_price - close_20d) / close_20d * 100 AS ret_20d \n FROM combined \n ORDER BY ret_20d DESC;
